// Boids 系统 —— 基于 3D 邻域网格的群体（flocking）动态模拟。自包含：
//   只使用引擎模块 + 同目录 NM/ 下的 .dfm（BoidsInitializeGrid / BoidsFillGrid / BoidsQueryGrid /
//   BoidsDebugGrid），不引用 NeighborGrid3D 工具箱的 .dfs / .dfm / NM 图模块，也不需要
//   Grid3D_CreateUnitToWorldTransform：世界坐标→单元索引由各 .dfm 用同一套公式自行换算，
//   网格中心取 Engine.Owner.Position（网格随 Actor 走，鸟群被回收力拴在网格内）。
//
// 行为: 分离 / 对齐 / 聚合三规则 → Reynolds steer → 写 Particles.Velocity。
//   位置积分由 ParticleUpdate 的 SolveForcesAndVelocity 负责；两个 Stage 都在它之后运行，
//   所以 Stage 里只写速度，不写位置（避免双重积分）。
// 自检着色（BoidsQueryGrid 写 Particles.Color，debug 用 RGB 纯色）: 在群里=绿 G，边缘=蓝 B，失联=红 R；
//   阈值只写在 BoidsQueryGrid.dfm 的着色条件里，注释不写具体数字，避免与代码漂移。
// 方向显示（MeshRenderer Arrows）: 每只 boid 渲染一个 Niagara 自带箭头网格
//   /Niagara/DefaultAssets/S_Arrow（指向 +X），FacingMode=Velocity 使网格 +X 对齐 Particles.Velocity。
//   缩放只沿箭头方向且与速度绑定: 每帧按当前速度写 Particles.Scale（长度系数与横向粗细见 ParticleUpdate 的赋值）。
//   颜色(#1): S_Arrow 自带的 M_Gnomon 是轴指示器材质，颜色以网格自带顶点色（红）为准，粒子色压不过它；
// 调试网格（Emitter DebugGrid from "../NE/BoidsDebugGrid"）: 每格一个立方体粒子，被占用的格子接近满格
//   尺寸、可见度高，空格缩成小点且很暗（用 M_Debug_Cell 时正常曝光下几乎看不见）；用来判断网格覆盖是否够、
//   哪些格子真的有 boid。
//   它只读网格、不参与模拟，删掉该 from 块即关闭；声明位置必须在 Boids 发射器之后（见该块的注释）。
//   发射器文本源在 NE/BoidsDebugGrid.dfe（.dfe 不生成资产，DFX5097），外观在 NM/BoidsDebugGrid.dfm。
//   箭头材质由 OverrideMaterials 整槽替换为 DShader/Boids/Material/M_BoidsArrow.dss 生成的
//   /Game/Boids/Material/M_BoidsArrow（Unlit，只读 Particle Color——渲染器 ColorBinding 传入的
//   每实例颜色流，而非 Vertex Color 读的网格顶点色），自检着色得以直接显示。
//   SpriteRenderer Core 保留但 bIsEnabled=false 禁用；渲染器块统一放在发射器末尾（Niagara 的排布习惯）。
//
// 本源文件原位构建资产 /Game/Boids/Niagara/NS_Boids。
System(Name="Boids/Niagara/NS_Boids", Root="Game")
{
    Settings = {
        WarmupTime = 0;
        FixedTickDelta = false;
        FixedTickDeltaTime = 0.01667;
    }

    Properties = {
        // 分组会写入资产的用户参数层级（Details 面板按此分组排序）；参数名是稳定键，勿改名。
        Group("邻域网格") {
            int    CellsX       = 20                       [ Description="网格 X 轴单元数；硬约束: CellsX ≤ GridSize.x / PerceptionRadius" ];
            int    CellsY       = 20                       [ Description="网格 Y 轴单元数；硬约束: CellsY ≤ GridSize.y / PerceptionRadius" ];
            int    CellsZ       = 20                       [ Description="网格 Z 轴单元数；硬约束: CellsZ ≤ GridSize.z / PerceptionRadius" ];
            Vector GridSize     = (4000.0, 4000.0, 4000.0) [ Description="网格世界尺寸（cm）；CellSize = GridSize / Cells，必须 ≥ PerceptionRadius" ];
            int    MaxNeighbors = 20                       [ Description="每格最多记录邻居数（MaxNeighborsPerCell）" ];
        }

        Group("群体") {
            int   Count       = 800   [ Description="boid 数量（一次 burst；用 burst 而非 SpawnRate 以固定规模）" ];
            float SpawnRadius = 600.0 [ Description="出生球半径（cm）" ];
        }

        Group("感知") {
            float PerceptionRadius = 180.0 [ Description="感知半径 R（cm）；必须 ≤ GridSize/Cells（默认 100），否则 27 邻格漏邻居" ];
            float SeparationRadius = 60.0 [ Description="分离半径 Rsep（cm），约 0.35×R" ];
        }

        Group("行为权重") {
            float WeightSeparation = 1.9 [ Description="分离权重" ];
            float WeightAlignment  = 0.7 [ Description="对齐权重" ];
            float WeightCohesion   = 0.5 [ Description="聚合权重" ];
        }

        Group("运动限制") {
            float MaxSpeed = 300.0 [ Description="最高速度（cm/s），必须 < SolveForcesAndVelocity 的 SpeedLimit(500)" ];
            float MinSpeed = 80.0 [ Description="最低速度（cm/s）；若起步抖动明显，先设为 0，稳定后再抬" ];
            float MaxForce = 800.0 [ Description="最大转向加速度（cm/s²）；dt=1/60 时每帧最多 Δv≈13cm/s" ];
        }

        Group("边界回收") {
            float BoundaryRadius = 1500.0 [ Description="活动半径（cm）：超出后施加回收力，避免飞出网格后失去邻居" ];
            float BoundaryForce  = 1200.0 [ Description="边界回收力强度（cm/s²）" ];
        }
    }

    SystemSpawn = {
        DI<NeighborGrid3D> System.MyNeighborGrid3D = "{\"MaxNeighborsPerCell\":20,\"ClearBeforeNonIterationStage\":true,\"NumCells\":{\"x\":40,\"y\":40,\"z\":40},\"CellSize\":100,\"NumCellsMaxAxis\":40,\"SetResolutionMethod\":\"CellSize\",\"WorldBBoxSize\":{\"x\":4000,\"y\":4000,\"z\":4000}}";
        /Game/Boids/Niagara/NM/BoidsInitializeGrid(
            GridIn = System.MyNeighborGrid3D,
            MaxNeighborsPerCell = User.MaxNeighbors,
            NumCellsX = User.CellsX,
            NumCellsY = User.CellsY,
            NumCellsZ = User.CellsZ
        );
    }

    SystemUpdate = {
        SystemState(
            InactiveResponse = Complete,
            LoopBehavior = Infinite,
            RecalculateDurationEachLoop = false,
            UseLoopDelay = false
        );
    }

    Emitter Boids
    {
        Settings = {
            SimTarget = GPU;
            CalculateBoundsMode = Fixed;
            FixedBounds = box(-2400.0, -2400.0, -2400.0, 2400.0, 2400.0, 2400.0);
            QualityLevelMask = 31;
        }

        EmitterSpawn = {
            DI<ParticleRead> Emitter.MyAttributeReader = "{\"EmitterBinding\":{\"bindingMode\":\"Self\",\"emitterName\":\"None\"}}";
        }

        EmitterUpdate = {
            EmitterState(
                LifeCycleMode = Self,
                InactiveResponse = Complete,
                LoopBehavior = Once,
                // LoopDurationMode = Fixed 且不写 LoopDuration 时引擎默认 1.0s：循环结束后发射器 Complete，
                // GPU 模拟停止调度，永不死亡的粒子被冻在 t=1s（表现为整群静止）。与 NS_WhatsNeighborGrid
                // 一致，用 Infinite 让这一次 burst 的鸟群永远模拟下去。
                LoopDurationMode = Infinite,
                ScalabilityMode = System,
                UseLoopDelay = false
            );
            SpawnBurst_Instantaneous(SpawnCount = User.Count, UseSpawnProbability = false, UseLoopCountLimit = false);
        }

        ParticleSpawn = {
            float Particles.Radius = RandomRangeFloat(RandomnessMode = SimulationDefaults, Minimum = 6.0, Maximum = 14.0);
            V2/InitializeParticle(
                LifetimeMode = DirectSet,
                ColorMode = RandomRange,
                ColorChannelMode = LinkRGB/LinkA,
                ColorRandomnessMode = SimulationDefaults,
                PositionMode = SimulationPosition,
                MassMode = DirectSet,
                SpriteSizeMode = Uniform,
                SpriteRotationMode = Unset,
                SpriteUVMode = Unset,
                MeshScaleMode = Unset,
                MeshRendererArrayVisibilityMode = Unset,
                RibbonWidthMode = Unset,
                RibbonFacingMode = Unset,
                RibbonTwistMode = Unset,
                ColorMinimum = (0.0, 1.0, 0.0, 1.0),
                ColorMaximum = (0.0, 1.0, 0.0, 1.0),
                Lifetime = 1.0,
                UsePositionOffset = false,
                Mass = Multiply_Float(
                    A = Multiply_Float(
                        A = Multiply_Float(A = Divide_Float(A = 4.0, B = 3.0), B = 3.141593),
                        B = Power(a = Particles.Radius, b = 3.0)
                    ),
                    B = 0.00008
                ),
                WriteMaterialRandom = true,
                UniformSpriteSize = 24.0
            );
            // 网格缩放不在出生时写死：箭头长度与速度绑定，由 ParticleUpdate 每帧按当前速度写入
            // Particles.Scale（见下）。InitializeParticle 的 MeshScaleMode 置为 Unset，避免多写一份均匀缩放。
            ShapeLocation(
                ShapePrimitive = Sphere,
                ApplyToParticlePosition = Apply,
                SphereDistribution = Random,
                HemisphereAngleType = NormalizedAngle,
                RandomnessMode = SimulationDefaults,
                TransformOrder = Scale/Rotate/Offset,
                ScaleMode = Default,
                RotationMode = Default,
                OffsetMode = None,
                TransformMethod = Default,
                SphereRadius = User.SpawnRadius,
                MaskSpawnGroup = false,
                OverrideSeed = false,
                UseOwnerScale = false
            );
            // DFX4022: 新属性首次赋值必须带类型；RandomRangeVector 每粒子各轴独立均匀随机（原逐轴 RandomRangeFloat 语义）
            Vector Particles.Velocity = RandomRangeVector(Minimum = (-80.0, -80.0, -80.0), Maximum = (80.0, 80.0, 80.0));
        }

        ParticleUpdate = {
            ParticleState@1.1(
                KillParticlesWhenLifetimeHasElapsed = false,
                LoopParticlesLifetime = false,
                LetInfinitelyLivedParticlesDieWhenEmitterDeactivates = false
            );
            SolveForcesAndVelocity(
                WritetoPresolveProperties = true,
                ClampVelocity = true,
                SpeedLimit = 500.0,
                LimitAcceleration = false,
                WritetoIntrinsicProperties = true,
                // Transient.PhysicsDeltaTime 在编辑器预览世界为 0（物理场景不 tick），位置积分 v·dt=0，
                // 鸟群在编辑器视口里完全静止；Engine.DeltaTime 在预览与游戏世界都有效（与本目录 .dfm 的默认一致）。
                DeltaTime = Engine.DeltaTime
            );
            // 箭头长度与速度绑定，只沿箭头方向拉长: MeshRenderer 默认 ScaleBinding 读 Particles.Scale，
            // 每帧按当前速度显式写入。
            // X 是长度系数、Y/Z 是横向粗细，想调整就改这三个分量（数值以表达式为准，注释不写具体数字）。
            // 用的是本帧解算后的速度（两个 Stage 改写的速度下一帧才反映，差一帧对调试不可感）。
            Vector Particles.Scale = hlsl { float3(length(Particles.Velocity) * 0.03, 8.0, 8.0) };
        }

        Stage FillGrid = {
            /Game/Boids/Niagara/NM/BoidsFillGrid(
                GridIn = System.MyNeighborGrid3D,
                In_GridCenter = Engine.Owner.Position,
                In_GridSize = User.GridSize
            );
        }

        Stage Boids = {
            /Game/Boids/Niagara/NM/BoidsQueryGrid(
                GridIn = System.MyNeighborGrid3D,
                AttributeReader = Emitter.MyAttributeReader,
                In_GridCenter = Engine.Owner.Position,
                In_GridSize = User.GridSize,
                In_PerceptionRadius = User.PerceptionRadius,
                In_SeparationRadius = User.SeparationRadius,
                In_WeightSeparation = User.WeightSeparation,
                In_WeightAlignment = User.WeightAlignment,
                In_WeightCohesion = User.WeightCohesion,
                In_MaxSpeed = User.MaxSpeed,
                In_MinSpeed = User.MinSpeed,
                In_MaxForce = User.MaxForce,
                In_AnchorPosition = Engine.Owner.Position,
                In_BoundaryRadius = User.BoundaryRadius,
                In_BoundaryForce = User.BoundaryForce
            );
        }

        // 渲染器放发射器末尾（与 Niagara 系统的排布一致；声明顺序 = 渲染顺序）。
        // 自检着色的粒子精灵保留但禁用，方向显示交给箭头网格。
        SpriteRenderer Core
        {
            bIsEnabled = false;
            Alignment = VelocityAligned;
            FacingMode = FaceCamera;
            Bind SpriteSize -> Particles.SpriteSize;
            Bind Color -> Particles.Color;
        }

        // 方向指示: Niagara 自带箭头网格 S_Arrow（本地 +X 即箭头指向）。
        // FacingMode=Velocity 是 ENiagaraMeshFacingMode 的枚举项，把网格 +X 对齐到 Particles.Velocity；
        // 缩放见 ParticleUpdate 里 Particles.Scale 的每帧赋值（长度与速度绑定，只沿 X 拉长）。
        // 颜色(#1): 箭头自带材质 M_Gnomon 只认网格顶点色（红），Bind Color 传的粒子色对它无效；
        //   用 M_BoidsArrow（DShader 文本源构建）整槽替换，该材质读 Particle Color 节点取本渲染器
        //   的每实例颜色（见下 Bind Color）。bOverrideMaterials 写在 OverrideMaterials 之前。
        MeshRenderer Arrows
        {
            bIsEnabled = true;
            Meshes     = ["/Niagara/DefaultAssets/S_Arrow"];
            FacingMode = Velocity;
            Bind Color -> Particles.Color;
            bOverrideMaterials = true;
            OverrideMaterials  = ["/Game/Boids/Material/M_BoidsArrow"];
        }
    }
}

    // 调试网格：可复用发射器，文本源在 ../NE/BoidsDebugGrid.dfe（.dfe 自身不生成资产，DFX5097）。
    // 关掉它 = 删掉本块；它对 Boids 模拟没有任何影响（只读网格，不写网格，也不写别人的粒子）。
    // 必须声明在 Boids 发射器**之后**：Stage FillGrid 先跑，本发射器再按本帧网格占用刷新。
    // 需要覆盖调试外观时写在下面的块里：Settings 按 key 合并，栈与渲染器是整块替换。
    Emitter DebugGrid from "./NE/BoidsDebugGrid"
    {
    }
