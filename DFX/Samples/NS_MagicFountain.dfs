// 入门 2：参数化 —— Group 作用域 User 参数 / 链接 / 动态输入嵌套 / 赋值 / Bind。
// 构建：pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Samples/NS_MagicFountain.dfs -Force
// 资产：/Game/Samples/Niagara/NS_MagicFountain    展示地图：/Game/Samples/Map/L_NiagaraShowcase
System(Name="Samples/Niagara/NS_MagicFountain")
{
    Settings = {
        WarmupTime  = 0.8;
        FixedBounds = box(-120, -120, -30, 120, 120, 340);
    }

    // Group("名") { ... } 作用域：组内参数继承组名、自动按序分配 SortPriority；
    // 分组写进资产参数树，详情面板按此展示；蓝图运行时可覆盖。
    Properties = {
        Group("发射") {
            float SpawnPerSecond = 140.0;
            float LaunchSpeed    = 480.0;
        }
        Group("外观") {
            float DropSize  = 4.5;
            Color WaterTint = (0.35, 0.68, 1.00, 1.0);
            Color FoamTint  = (0.85, 0.95, 1.00, 1.0);
        }
        Group("物理") {
            float PullStrength = 700.0
                [ Description="把水滴往喷口方向拉回的向心引力；设 0 就是普通抛物线喷泉" ];
        }
    }

    Emitter Drops
    {
        Settings = {
            SimTarget          = CPU;
            AllocationMode     = Fixed;
            PreAllocationCount = 512;
            Determinism        = true;   // 随机 + 可复现（DFX7103）；想每局不同就删掉
            RandomSeed         = 2024;
        }

        EmitterUpdate = {
            EmitterState();   // 无输入 = 系统级生命周期 + 无限循环
            SpawnRate(SpawnRate = User.SpawnPerSecond);
        }

        ParticleSpawn = {
            Spawn/Location/V2/SphereLocation(SphereRadius = 6.0);

            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode   = Random,
                LifetimeMin    = 0.8,
                LifetimeMax    = 1.4,
                ColorMode      = RandomRange,
                ColorMinimum   = User.WaterTint,
                ColorMaximum   = User.FoamTint,
                SpriteSizeMode = RandomUniform,
                UniformSpriteSizeMin = User.DropSize * 0.6,   // 内联算术仅 L6 白名单（DFX4031）
                UniformSpriteSizeMax = User.DropSize
            );

            SystemLocation(Offset = (0, 0, 10));

            AddVelocityInCone(
                ConeAxis         = (0, 0, 1),
                ConeAngle        = 22.0,
                VelocityStrength = RandomRangeFloat(   // 动态输入可无限嵌套
                                       Minimum = User.LaunchSpeed * 0.75,
                                       Maximum = User.LaunchSpeed
                                   )
            );

            // 首赋值声明新属性；值非字面量时必须写出类型；连续赋值折叠成一个 Set Parameters（L2）。
            float Particles.FX.Spin = RandomRangeFloat(Minimum = -180.0, Maximum = 180.0);
        }

        ParticleUpdate = {
            ParticleState();

            GravityForce(Gravity = (0, 0, -980));
            Update/Forces/V2/PointAttractionForce(   // 短名有歧义，点名 V2
                AttractionStrength = User.PullStrength,
                AttractionRadius   = 80.0,
                UseFalloff         = true,
                FalloffExponent    = 1.5
            );
            Drag(Drag = 0.8);
            SolveForcesAndVelocity();

            ScaleSpriteSize(
                ScaleSpriteSizeMode = Uniform,
                UniformScaleFactor  = FloatFromCurve(
                    FloatCurve = curve {
                        0.0 -> 0.55;
                        0.2 -> 1.0  [ Interp=Cubic; Arrive=0.6; Leave=1.4 ];
                        1.0 -> 0.3  [ Interp=Linear ];
                    },
                    CurveIndex = Particles.NormalizedAge
                )
            );
        }

        SpriteRenderer Core
        {
            FacingMode = FaceCamera;
            SortMode   = ViewDepth;

            // Bind 是独立语法，不是属性赋值。
            Bind Color          -> Particles.Color;
            Bind SpriteSize     -> Particles.SpriteSize;
            Bind SpriteRotation -> Particles.FX.Spin;
        }
    }
}
