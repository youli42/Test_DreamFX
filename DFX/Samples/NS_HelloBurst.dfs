// 入门 1：语言骨架 —— System / Emitter / 四个堆栈 / 静态开关 / 曲线字面量。
// 构建：pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Samples/NS_HelloBurst.dfs -Force
// 资产：/Game/Samples/Niagara/NS_HelloBurst    展示地图：/Game/Samples/Map/L_NiagaraShowcase
System(Name="Samples/Niagara/NS_HelloBurst")
{
    // Emitter 名是稳定键：改名要用 dfx.ps1 rename，别直接改。
    Emitter Sparks
    {
        EmitterUpdate = {
            // 静态开关决定输入是否存在，顺序即写入顺序，写反报 DFX5021。
            EmitterState(
                LifeCycleMode    = Self,
                LoopBehavior     = Infinite,   // 改成 Once 即一次性爆裂
                InactiveResponse = Complete,
                LoopDuration     = 1.5
            );
            SpawnBurst_Instantaneous(SpawnCount = 32, SpawnTime = 0.0);
        }

        ParticleSpawn = {
            // 枚举解锁输入：Random 解锁 Min/Max；旧版同名模块已弃用（DFX6004）。
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode   = Random,
                LifetimeMin    = 0.4,
                LifetimeMax    = 0.8,
                ColorMode      = RandomRange,
                ColorMinimum   = (1.0, 0.30, 0.05, 1.0),
                ColorMaximum   = (1.0, 0.80, 0.30, 1.0),
                SpriteSizeMode = RandomUniform,
                UniformSpriteSizeMin = 2.0,
                UniformSpriteSizeMax = 5.0
            );

            // 平面圆环出生：Ring 模式 + 大半径；AlignTorusWithAxis 解锁 TorusAxis（开关在前）。
            Spawn/Location/TorusLocation(
                TorusMode          = Ring,
                LargeRadius        = 50.0,
                AlignTorusWithAxis = true,
                TorusAxis          = (0, 0, 1)
            );

            // SystemLocation();

            // 径向扩散：速度 = 从所属组件位置指向粒子的单位向量 × 480（hlsl 单 rvalue）。
            AddVelocity(
                Velocity = hlsl { normalize(Particles.Position - Engine.Owner.Position) * 480.0 }
            );
        }

        ParticleUpdate = {
            // 提供 NormalizedAge，必须先于用它的模块，否则曲线永远取 0。
            ParticleState();

            GravityForce(Gravity = (0, 0, -500));
            Drag(Drag = 1.0);
            SolveForcesAndVelocity();

            // 曲线键：时间 -> 值 [ Interp=Linear|Cubic; Arrive=…; Leave=… ];
            ScaleSpriteSize(
                ScaleSpriteSizeMode = Uniform,
                UniformScaleFactor  = FloatFromCurve(
                    FloatCurve = curve {
                        0.0 -> 1.0;
                        1.0 -> 0.0 [ Interp=Linear ];
                    },
                    CurveIndex = Particles.NormalizedAge
                )
            );
        }

        // 空块 = 引擎默认材质与绑定（DFX5004 提示一声）。
        SpriteRenderer Core
        {
        }
    }
}
