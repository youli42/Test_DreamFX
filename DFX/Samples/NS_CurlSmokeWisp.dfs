// 入门 3：GPU 粒子 —— SimTarget=GPU / 开关门控 / hlsl 单表达式。
// 构建：pwsh -File Plugins/DreamFX/.skill/dfx.ps1 build DFX/Samples/NS_CurlSmokeWisp.dfs -Force
// 资产：/Game/Samples/Niagara/NS_CurlSmokeWisp    展示地图：/Game/Samples/Map/L_NiagaraShowcase
System(Name="Samples/Niagara/NS_CurlSmokeWisp")
{
    Settings = {
        WarmupTime  = 2.0;   // 暖机后打开即是"烧过一会儿"的状态
        FixedBounds = box(-90, -90, -40, 90, 90, 260);
    }

    Emitter Wisp
    {
        Settings = {
            SimTarget          = GPU;    // GPU 与 Determinism 互斥
            AllocationMode     = Fixed;
            PreAllocationCount = 256;
            FixedBounds        = box(-90, -90, -40, 90, 90, 260);   // GPU 算不了包围盒（DFX7101）
        }

        EmitterUpdate = {
            EmitterState();
            SpawnRate(SpawnRate = 40.0);
        }

        ParticleSpawn = {
            Spawn/Location/V2/SphereLocation(SphereRadius = 3.0);

            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode = Random,
                LifetimeMin  = 1.6,
                LifetimeMax  = 2.6,
                ColorMode    = DirectSet,   // 开关在前，被它解锁的输入在后
                Color        = (0.55, 0.55, 0.58, 0.30),
                SpriteSizeMode = Uniform,
                UniformSpriteSize = 9.0
            );

            SystemLocation(Offset = (0, 0, 10));
        }

        ParticleUpdate = {
            ParticleState();

            // 无散度流场：烟是"卷"不是"抖"；PanNoise 让场随时间平移。
            Update/Forces/V2/CurlNoiseForce(
                NoiseStrength  = 110.0,
                NoiseFrequency = 0.15,
                PanNoise       = true,
                PanNoiseField  = (0, 0, 25.0)
            );
            Drag(Drag = 1.2);
            SolveForcesAndVelocity();

            ScaleSpriteSize(
                ScaleSpriteSizeMode = Uniform,
                UniformScaleFactor  = FloatFromCurve(
                    FloatCurve = curve {
                        0.0 -> 0.4;
                        1.0 -> 1.6 [ Interp=Linear ];
                    },
                    CurveIndex = Particles.NormalizedAge
                )
            );

            // hlsl 只接受一个 rvalue（DFX4030），类型必须手写；多语句逻辑请写 .dfm。
            Color Particles.Color = hlsl {
                float4(Particles.Color.rgb,
                       Particles.Color.a
                           * saturate(1.5 * Particles.NormalizedAge)
                           * saturate(1.0 - Particles.NormalizedAge))
            };
        }

        SpriteRenderer Puff
        {
            FacingMode = FaceCamera;

            Bind Color      -> Particles.Color;
            Bind SpriteSize -> Particles.SpriteSize;
        }
    }
}
